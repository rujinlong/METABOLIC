manifest {
    name = 'METABOLIC-Nextflow'
    author = 'Antigravity'
    description = 'Nextflow implementation of METABOLIC'
    version = '1.0.0'
    nextflowVersion = '>=21.10.0'
}

params {
    // Input/Output defaults
    input_genomes = null
    input_proteins = null
    outdir = 'results'
    
    // Database root directory - set this to your centralized database location
    // Default: $HOME/database/METABOLIC (recommended for multi-project use)
    // Override with: --db_dir /path/to/your/METABOLIC_databases
    db_dir = "${System.getenv('HOME')}/database/METABOLIC"
    
    // Database paths (relative to db_dir)
    kofam_dir = "${params.db_dir}/kofam_database/kofam_merged.hmm"
    metabolic_hmm_dir = "${params.db_dir}/METABOLIC_hmm_db"
    
    // Ancillary files
    kofam_threshold = "${params.db_dir}/METABOLIC_template_and_database/prokaryote.hal"
    motif_file = "${params.db_dir}/METABOLIC_template_and_database/motif.txt"
    motif_pair_file = "${params.db_dir}/METABOLIC_template_and_database/motif.pair.txt"
    hmm_template_1 = "${params.db_dir}/METABOLIC_template_and_database/hmm_table_template.txt"
    hmm_template_2 = "${params.db_dir}/METABOLIC_template_and_database/hmm_table_template_2.txt"
    kegg_module_db = "${params.db_dir}/METABOLIC_template_and_database/ko00002.keg"
    kegg_steps_db = "${params.db_dir}/METABOLIC_template_and_database/kegg_module_step_db.txt"
    dbcan_db = "${params.db_dir}/dbCAN2/dbCAN-fam-HMMs.txt"
    merops_db = "${params.db_dir}/MEROPS/pepunit.db"
    merops_lib = "${params.db_dir}/MEROPS/pepunit.lib"
    
    // Resource defaults
    max_memory = '16.GB'
    max_cpus = 8
    max_time = '24.h'
    
    // Options
    pyrodigal_mode = 'single'  // 'single' for isolates, 'meta' for metagenomes
    help = false
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        process.container = 'jinlongru/metabolic:latest'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    test {
        params.input_genomes = "${launchDir}/tests/data"
        params.kofam_dir = "${launchDir}/tests/database/kofam_database/kofam_merged.hmm"
        params.metabolic_hmm_dir = "${launchDir}/tests/database/METABOLIC_hmm_db"
        params.kofam_threshold = "${launchDir}/tests/database/METABOLIC_template_and_database/prokaryote.hal"
        params.motif_file = "${launchDir}/tests/database/METABOLIC_template_and_database/motif.txt"
        params.motif_pair_file = "${launchDir}/tests/database/METABOLIC_template_and_database/motif.pair.txt"
        params.hmm_template_1 = "${launchDir}/tests/database/METABOLIC_template_and_database/hmm_table_template.txt"
        params.hmm_template_2 = "${launchDir}/tests/database/METABOLIC_template_and_database/hmm_table_template_2.txt"
        params.kegg_module_db = "${launchDir}/tests/database/METABOLIC_template_and_database/ko00002.keg"
        params.kegg_steps_db = "${launchDir}/tests/database/METABOLIC_template_and_database/kegg_module_step_db.txt"
        params.dbcan_db = "${launchDir}/tests/database/dbCAN2/dbCAN-fam-HMMs.txt"
        params.merops_db = "${launchDir}/tests/database/MEROPS/pepunit.db.dmnd"
        params.merops_lib = "${launchDir}/tests/database/MEROPS/pepunit.lib"
    }
    test_proteins {
        // Protein-only test - skip Prodigal
        params.input_proteins = "${launchDir}/tests/proteins"
        params.kofam_dir = "${launchDir}/tests/database/kofam_database/kofam_merged.hmm"
        params.metabolic_hmm_dir = "${launchDir}/tests/database/METABOLIC_hmm_db"
        params.kofam_threshold = "${launchDir}/tests/database/METABOLIC_template_and_database/prokaryote.hal"
        params.motif_file = "${launchDir}/tests/database/METABOLIC_template_and_database/motif.txt"
        params.motif_pair_file = "${launchDir}/tests/database/METABOLIC_template_and_database/motif.pair.txt"
        params.hmm_template_1 = "${launchDir}/tests/database/METABOLIC_template_and_database/hmm_table_template.txt"
        params.hmm_template_2 = "${launchDir}/tests/database/METABOLIC_template_and_database/hmm_table_template_2.txt"
        params.kegg_module_db = "${launchDir}/tests/database/METABOLIC_template_and_database/ko00002.keg"
        params.kegg_steps_db = "${launchDir}/tests/database/METABOLIC_template_and_database/kegg_module_step_db.txt"
        params.dbcan_db = "${launchDir}/tests/database/dbCAN2/dbCAN-fam-HMMs.txt"
        params.merops_db = "${launchDir}/tests/database/MEROPS/pepunit.db.dmnd"
        params.merops_lib = "${launchDir}/tests/database/MEROPS/pepunit.lib"
    }
}

// Process resource allocation
process {
    withLabel: 'process_low' {
        cpus = 2
        memory = '4.GB'
        time = '4.h'
    }
    withLabel: 'process_medium' {
        cpus = 4
        memory = '16.GB'
        time = '12.h'
    }
    withLabel: 'process_high' {
        cpus = { Math.min(params.max_cpus, Runtime.runtime.availableProcessors()) }
        memory = '8.GB'
        time = '24.h'
    }
}
