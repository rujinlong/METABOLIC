manifest {
    name = 'METABOLIC-Nextflow'
    author = 'Jinlong Ru'
    description = 'Nextflow implementation of METABOLIC - HPC optimized'
    version = '2.0.0'
    nextflowVersion = '>=21.10.0'
}

params {
    // Input (required)
    proteins = null      // Single concatenated protein FASTA
    contig_map = null    // TSV: contigID -> genomeID
    
    // Output
    outdir = 'results'
    
    // Database root directory
    db_dir = "${System.getenv('HOME')}/data2/db/metabolic/METABOLIC"
    
    // Database paths (relative to db_dir)
    kofam_dir = "${params.db_dir}/kofam_database/kofam_all.hmm"
    metabolic_hmm = "${params.db_dir}/custom_db/metabolic_all.hmm"
    
    // Ancillary files
    ko_list = "${params.db_dir}/kofam_database/ko_list"
    motif_file = "${params.db_dir}/METABOLIC_template_and_database/motif.txt"
    motif_pair_file = "${params.db_dir}/METABOLIC_template_and_database/motif.pair.txt"
    hmm_template_1 = "${params.db_dir}/METABOLIC_template_and_database/hmm_table_template.txt"
    hmm_template_2 = "${params.db_dir}/METABOLIC_template_and_database/hmm_table_template_2.txt"
    kegg_module_db = "${params.db_dir}/METABOLIC_template_and_database/ko00002.keg"
    kegg_steps_db = "${params.db_dir}/METABOLIC_template_and_database/kegg_module_step_db.txt"
    dbcan_db = "${params.db_dir}/dbCAN2/dbCAN-fam-HMMs.txt"
    merops_db = "${params.db_dir}/MEROPS/pepunit.db.dmnd"
    merops_lib = "${params.db_dir}/MEROPS/pepunit.lib"
    
    // Visualization files
    r_pathways = "${params.db_dir}/METABOLIC_template_and_database/R_pathways.txt"
    metabolic_dir = "${projectDir}/.."  // Points to METABOLIC root for R scripts
    
    // Clustering options
    skip_cluster = false       // Set to true to skip MMseqs2 clustering
    cluster_sid = 0.8          // Minimum sequence identity (default: 80%)
    cluster_cov = 0.8          // Minimum coverage (default: 80%)
    
    // Analysis options
    module_cutoff = 0.5       // KEGG module presence cutoff (default: 50% steps)
    
    // Chunking options for parallel processing
    chunk_size = 100000        // Proteins per chunk for parallel HMM search
    
    // Visualization options
    disable_plot = false       // Set to true to skip R_input and PDF generation (for large datasets)
    
    help = false
}

// ============================================================================
// BASE RESOURCE ALLOCATION (independent of executor)
// ============================================================================
process {
    // Default fallback
    cpus = 1
    memory = '8.GB'
    time = '23.h'
    
    // Light tasks: parsing, table generation, visualization
    withLabel: 'process_low' {cpus = 1; memory = '8.GB'}
    
    // Medium tasks: Pyrodigal, MMseqs2 clustering
    withLabel: 'process_medium' {cpus = 3; memory = '8.GB'}
    
    // Heavy tasks: HMMsearch, Diamond (default for SLURM)
    withLabel: 'process_high' {cpus = 4; memory = '10.GB'}
}

// ============================================================================
// PROFILES - Control executor and container
// ============================================================================
profiles {
    
    // ========================================================================
    // EXECUTION PROFILES (choose one)
    // ========================================================================
    
    // Default: Hybrid mode - light tasks local, heavy tasks on SLURM (cpu_normal, max 24h)
    standard {
        process.executor = 'local'
        process {
            withLabel: 'process_high' {
                executor = 'slurm'
                queue = 'cpu_p'
                clusterOptions = '-q cpu_normal'
            }
        }
    }
    
    // Preemptible: Only HMMSEARCH_KO uses cpu_preemptible (72h), others use cpu_normal
    preemptible {
        process.executor = 'local'
        process {
            // Default: process_high still uses cpu_normal
            withLabel: 'process_high' {
                executor = 'slurm'
                queue = 'cpu_p'
                clusterOptions = '-q cpu_normal'
            }
            // Override: HMMSEARCH_KO uses cpu_preemptible for large datasets
            withName: 'HMMSEARCH_KO' {
                executor = 'slurm'
                queue = 'cpu_p'
                clusterOptions = '-q cpu_preemptible'
                time = '71.h'
            }
        }
    }
    
    // All Local: Run everything locally (when cluster is busy or for debugging)
    local {
        process.executor = 'local'
        // Cap resources to avoid OOM on login nodes
        process {
            withLabel: 'process_high' {
                cpus = 3
                memory = '32.GB'
                time = '100.h'
            }
        }
    }
    
    // All Cluster: Submit everything to SLURM (avoid any local computation)
    cluster {
        process.executor = 'slurm'
        process.queue = 'cpu_p'
        process.clusterOptions = '-q cpu_normal'
        // Minimal resources for light tasks
        process {
            withLabel: 'process_low' {
                cpus = 1
                memory = '30.GB'
                time = '23.h'
                queue = 'cpu_p'
                clusterOptions = '-q cpu_normal'
            }
            withLabel: 'process_medium' {
                cpus = 20
                memory = '140.GB'
                time = '23.h'
                queue = 'cpu_p'
                clusterOptions = '-q cpu_normal'
            }
            withLabel: 'process_high' {
                cpus = 25
                memory = '200.GB'
                time = '71.h'
                queue = 'cpu_p'
                clusterOptions = '-q cpu_preemptible'
            }
            withName: 'HMMSEARCH_KO' {
                cpus = 45
                memory = '300.GB'
                time = '71.h'
                queue = 'cpu_p'
                clusterOptions = '-q cpu_preemptible'
            }
            withName: 'MMSEQS_CLUSTER' {
                cpus = 45
                memory = '400.GB'
            }
        }
    }
    
    // ========================================================================
    // CONTAINER PROFILES (composable - combine with execution profiles)
    // ========================================================================
    
    docker {
        docker.enabled = true
        process.container = 'jinlongru/metabolic:latest'
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "--writable-tmpfs -B /ictstr01/project/genomics -B /project/genomics -B ${HOME} -B /localscratch"
        process.container = 'jinlongru/metabolic:latest'
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = "--writable-tmpfs -B /ictstr01/project/genomics -B /project/genomics -B ${HOME} -B /localscratch"
        process.container = 'jinlongru/metabolic:latest'
    }
    
    // ========================================================================
    // TEST PROFILE
    // ========================================================================
    
    test {
        params.proteins = "${projectDir}/tests/proteins/all_proteins.faa"
        params.contig_map = "${projectDir}/tests/proteins/contig_map.tsv"
        params.kofam_dir = "${projectDir}/tests/database/kofam_database/kofam_merged.hmm"
        params.metabolic_hmm = "${projectDir}/tests/database/custom_db/custom.hmm"
        params.ko_list = "${projectDir}/tests/database/kofam_database/ko_list"
        params.motif_file = "${projectDir}/tests/database/METABOLIC_template_and_database/motif.txt"
        params.motif_pair_file = "${projectDir}/tests/database/METABOLIC_template_and_database/motif.pair.txt"
        params.hmm_template_1 = "${projectDir}/tests/database/METABOLIC_template_and_database/hmm_table_template.txt"
        params.hmm_template_2 = "${projectDir}/tests/database/METABOLIC_template_and_database/hmm_table_template_2.txt"
        params.kegg_module_db = "${projectDir}/tests/database/METABOLIC_template_and_database/ko00002.keg"
        params.kegg_steps_db = "${projectDir}/tests/database/METABOLIC_template_and_database/kegg_module_step_db.txt"
        params.dbcan_db = "${projectDir}/tests/database/dbCAN2/dbCAN-fam-HMMs.txt"
        params.merops_db = "${projectDir}/tests/database/MEROPS/pepunit.db.dmnd"
        params.merops_lib = "${projectDir}/tests/database/MEROPS/pepunit.lib"
    }
}
